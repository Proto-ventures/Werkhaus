#!/usr/bin/env bash
# Start Werkhaus with the model configured, so the front door works.
#
# Without WERKHAUS_MODEL the API still serves, but every attempt to create a
# company answers 503 "no employee has a brain to think with yet" — which is
# honest, and is also the wall you hit if you forget to export it.
set -euo pipefail
cd "$(dirname "$0")"

if [[ -f werkhaus.env ]]; then
  # Defaults, not overrides: a variable already set on the command line wins,
  # so `WERKHAUS_DATA=./scratch ./run` does what it looks like it does.
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# || -z "${line// }" ]] && continue
    key="${line%%=*}"; val="${line#*=}"; val="${val%\"}"; val="${val#\"}"
    [[ -z "${!key:-}" ]] && export "$key=$val"
  done < werkhaus.env
else
  echo "no werkhaus.env — copy werkhaus.env.example and fill it in" >&2
fi

if [[ -z "${WERKHAUS_MODEL:-}" ]]; then
  echo "WERKHAUS_MODEL is not set: companies cannot be created." >&2
fi

exec uv run uvicorn werkhaus.api.app:app --reload --port "${PORT:-8000}"
