# Copy to `werkhaus.env` and fill in. That file is gitignored.
#
# Deliberately not called `.env`: the SDK's observability helper reads a `.env`
# from the working directory, so a file with that name would be picked up by
# something other than us.

# The employees' brain. Any litellm model string.
#
# A shift is ~12 model calls and ~120k tokens after the batching work, and the
# thing to check a provider against is *latency*, not its limits: a measured
# shift on NIM's free endpoint spent 77 of its 79 minutes waiting on the model
# at a median 92s per call, while the whole web read took 30 seconds.
#
#   Mistral      1B tokens/month free, ~1 req/sec  -> ~8,000 shifts/month.
#                The one that does not run out.
#   Cerebras     30 RPM, 60k TPM, 1M tokens/day    -> ~8 shifts/day, fastest
#                inference available. Best when you want the answer now.
#   NVIDIA NIM   40 RPM, credit-based, no token cap. No limit trouble; slow.
#   Groq         6k TPM — one call of ours exceeds it. Not usable here.
#
WERKHAUS_MODEL="mistral/mistral-large-latest"
MISTRAL_API_KEY=""
# or: WERKHAUS_MODEL="cerebras/llama-3.3-70b"
#     CEREBRAS_API_KEY=""
# or: WERKHAUS_MODEL="nvidia_nim/nvidia/llama-3.3-nemotron-super-49b-v1.5"
#     NVIDIA_NIM_API_KEY=""

# Where companies live.
WERKHAUS_DATA="./data"

# A SearXNG you run yourself, used before the keyless fallbacks. Strongly
# preferred if you have one: it fans a query out across many upstream engines,
# so none of them sees enough traffic from us to start refusing — which is the
# failure the fallbacks keep hitting. No key, and nobody outside learns what
# the company is researching.
#
#   docker run -d --name searxng -p 8888:8080 \
#     -v "$PWD/searxng:/etc/searxng" docker.io/searxng/searxng:latest
#
# SearXNG ships with JSON OFF. In searxng/settings.yml add it to the formats
# list, or every query here comes back empty:
#
#   search:
#     formats:
#       - html
#       - json
#
WERKHAUS_SEARCH_URL=""

# Set to 1 to run without a chromium. Employees keep web_search and web_read —
# which is how they read anyway — and lose only the fallback for pages that
# build themselves with scripts. Measured: with chromium in the tool list a
# model made 29 browser_navigate calls and zero web_read calls, for roughly
# four times the token bill, because browser_navigate is the most familiar web
# action there is.
WERKHAUS_NO_BROWSER=""

# What a shift costs, per million tokens. Set both to 0 on a free tier so the
# ledger reads $0.00 because it was free, not because nobody knew the price.
WERKHAUS_INPUT_COST_PER_MTOK="0"
WERKHAUS_OUTPUT_COST_PER_MTOK="0"
