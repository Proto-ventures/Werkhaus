# Copy to `werkhaus.env` and fill in. That file is gitignored.
#
# Deliberately not called `.env`: the SDK's observability helper reads a `.env`
# from the working directory, so a file with that name would be picked up by
# something other than us.

# The employees' brain. Any litellm model string.
WERKHAUS_MODEL="nvidia_nim/nvidia/llama-3.3-nemotron-super-49b-v1.5"
NVIDIA_NIM_API_KEY=""
# or: WERKHAUS_MODEL="openrouter/qwen/qwen3-235b-a22b-2507"
#     OPENROUTER_API_KEY=""

# Where companies live.
WERKHAUS_DATA="./data"

# What a shift costs, per million tokens. Set both to 0 on a free tier so the
# ledger reads $0.00 because it was free, not because nobody knew the price.
WERKHAUS_INPUT_COST_PER_MTOK="0"
WERKHAUS_OUTPUT_COST_PER_MTOK="0"
